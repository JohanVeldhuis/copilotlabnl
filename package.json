{
  "name": "copilot-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "prepare:content": "node scripts/prepare-content.mjs",
    "artwork": "node scripts/artwork.mjs",
    "prepare:site": "npm run prepare:content && npm run artwork",
    "dev": "npm run prepare:site && astro dev",
    "check": "npm run prepare:site && astro check",
    "build": "npm run prepare:site && astro build && pagefind --site dist",
    "preview": "astro preview",
    "test": "node --test tests/content.test.mjs",
    "test:browser": "playwright test",
    "validate": "npm run check && npm run test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "astro": "7.3.5",
    "gray-matter": "4.0.3",
    "marked": "18.0.14",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "pagefind": "1.5.2",
    "typescript": "~5.9.3"
  }
}
