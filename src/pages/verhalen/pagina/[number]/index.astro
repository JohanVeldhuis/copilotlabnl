---
import { getStories } from '../../../../lib/content';
import StoryListing from '../../../../components/StoryListing.astro';
export async function getStaticPaths() {
  const stories = await getStories();
  const pages = Math.ceil(stories.length / 6);
  return Array.from({ length: pages - 1 }, (_, index) => {
    const page = index + 2;
    return { params: { number: String(page) }, props: { stories: stories.slice((page - 1) * 6, page * 6), page, pages } };
  });
}
const { stories, page, pages } = Astro.props;
---
<StoryListing stories={stories} page={page} pages={pages} />
