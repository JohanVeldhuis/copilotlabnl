---
import Base from '../../layouts/Base.astro';
import { getStories, dateLabel } from '../../lib/content';
const stories = (await getStories()).filter((story) => story.data.status === 'archived');
const categories = ['informatie', 'Word', 'Excel', 'Copilot'];
---
<Base title="Het archief" description="Alle oorspronkelijke verhalen en demonstraties uit 2024, met hun historische context.">
  <div class="wrap">
    <header class="page-head"><div class="eyebrow">De geschiedenis van het lab</div><h1>Niet verdwenen.<br />Wel in perspectief.</h1><p class="lede">Hier vind je alle oorspronkelijke artikelen uit 2024. De teksten en video's zijn behouden, maar niet opnieuw productgetest. Functies, licenties en schermen kunnen inmiddels verschillen.</p></header>
    <nav class="filter-links" aria-label="Archiefcategorieën">{categories.map((category) => <a class="topic" href={`#${category}`}>{category === 'informatie' ? 'Informatie' : category}</a>)}<a class="topic" href="/verhalen/">Naar alle verhalen ↗</a></nav>
    {categories.map((category) => <section class="archive-section" aria-labelledby={category}>
      <h2 id={category}>{category === 'informatie' ? 'Informatie' : category}</h2>
      <ul class="archive-list">{stories.filter((story) => story.data.topic === category.toLowerCase()).map((story) => <li><a href={story.data.url}>{story.data.title}</a><time datetime={story.data.published}>{dateLabel(story.data.published)} · Archief</time>{story.data.refreshedUrl && <p><a href={story.data.refreshedUrl}>Ook beschikbaar: een nieuwe redactionele editie →</a></p>}</li>)}</ul>
    </section>)}
  </div>
</Base>
