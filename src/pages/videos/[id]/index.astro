---
import Base from '../../../layouts/Base.astro';
import VideoEmbed from '../../../components/VideoEmbed.astro';
import ArchiveNotice from '../../../components/ArchiveNotice.astro';
import ArticleBody from '../../../components/ArticleBody.astro';
import { getVideos, getStories, topicLabel } from '../../../lib/content';
export async function getStaticPaths() {
  return (await getVideos()).map((video) => ({ params: { id: video.id }, props: { video } }));
}
const { data } = Astro.props.video;
const related = (await getStories()).filter((story) => story.data.videoIds.includes(data.youtubeId));
---
<Base title={data.title} description={data.description} canonical={data.url}>
  <div class="wrap">
    <div class="video-detail" data-pagefind-body>
      <header class="page-head">
        <nav class="breadcrumbs" aria-label="Broodkruimelpad" data-pagefind-ignore><a href="/">Home</a><span aria-hidden="true">/</span><a href="/videos/">Video's</a></nav>
        <div class="meta"><span class="badge badge-video" data-pagefind-meta="type">Video</span><span>{topicLabel(data.topic)}</span></div>
        <h1 data-pagefind-meta="title">{data.title}</h1><p class="lede">{data.status === 'archived' ? 'Een historische demonstratie bij het verhaal van Johan Veldhuis.' : data.description}</p>
      </header>
      {data.status === 'archived' && <ArchiveNotice video />}
      <VideoEmbed youtubeId={data.youtubeId} title={data.title} art={data.art} />
      {data.status === 'archived' && <section class="prose"><h2>De uitleg bij deze demo</h2><p>Deze opname is onderdeel van <a href={data.storyUrl}>{data.storyTitle}</a>. In het oorspronkelijke artikel vind je de gebruikte prompts, stappen en opmerkingen van toen.</p><p>{data.description} Er is voor deze opname nog geen gecontroleerd transcript of actuele producttest toegevoegd.</p></section>}
      {data.body && <ArticleBody body={data.body} title={data.title} />}
      {related.length > 0 && <section class="prose"><h2>Bijbehorende verhalen</h2><ul>{related.map((story) => <li><a href={story.data.url}>{story.data.title}</a></li>)}</ul></section>}
    </div>
  </div>
</Base>
