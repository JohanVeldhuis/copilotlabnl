---
import { getStories } from '../../../../../lib/content';
import StoryPage from '../../../../../components/StoryPage.astro';
export async function getStaticPaths() {
  return (await getStories()).filter((story) => story.data.status === 'archived').map((story) => {
    const [, category, year, month, day, filename] = story.data.url.split('/');
    return {
      params: { category, year, month, day, slug: filename.replace(/\.html$/, '') },
      props: { story },
    };
  });
}
const { story } = Astro.props;
---
<StoryPage story={story} />
