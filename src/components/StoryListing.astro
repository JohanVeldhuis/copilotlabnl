---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryCard from './StoryCard.astro';
interface Props { stories: CollectionEntry<'stories'>[]; page?: number; pages?: number; legacy?: boolean }
const { stories, page = 1, pages = 1, legacy = false } = Astro.props;
const url = legacy ? `/page/${page}/` : page === 1 ? '/verhalen/' : `/verhalen/pagina/${page}/`;
const pageUrl = (number: number) => legacy ? number === 1 ? '/posts/' : `/page/${number}/` : number === 1 ? '/verhalen/' : `/verhalen/pagina/${number}/`;
---
<Base title={`${legacy ? 'Uit het archief' : 'Verhalen'}${page > 1 ? ` — pagina ${page}` : ''}`} canonical={url} noindex={legacy || page > 1}>
  <div class="wrap">
    <header class="page-head"><div class="eyebrow">Een persoonlijk perspectief</div><h1>{legacy ? 'Uit het archief.' : 'Ideeën om mee verder te gaan.'}</h1><p class="lede">Heldere uitleg, praktische voorbeelden en lessen uit het lab. Historische artikelen zijn herkenbaar als archief en blijven beschikbaar.</p></header>
    <nav class="filter-links" aria-label="Verhalen ontdekken"><a class="topic" href="/verhalen/">Alle verhalen</a><a class="topic" href="/onderwerpen/prompting/">Slimmer prompten</a><a class="topic" href="/onderwerpen/excel/">Excel</a><a class="topic" href="/onderwerpen/copilot/">Copilot</a><a class="topic" href="/posts/">Archief 2024</a><a class="topic" href="/zoeken/">Zoeken ↗</a></nav>
    <div class="cards">{stories.map((story) => <StoryCard story={story} />)}</div>
    <nav class="pagination" aria-label="Paginering">{Array.from({ length: pages }, (_, index) => index + 1).map((number) => number === page ? <span aria-current="page">Pagina {number}</span> : <a href={pageUrl(number)}>Pagina {number}</a>)}</nav>
  </div>
</Base>
