---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArchiveNotice from './ArchiveNotice.astro';
import ArticleBody from './ArticleBody.astro';
import { dateLabel, getStories, topicLabel } from '../lib/content';
interface Props { story: CollectionEntry<'stories'> }
const { story } = Astro.props;
const { data } = story;
const related = (await getStories()).filter((item) => item.id !== story.id && item.data.status !== 'archived').slice(0, 2);
---
<Base title={data.title} description={data.description} canonical={data.url} article published={data.published}>
  <div class="wrap" data-pagefind-body>
    <header class="page-head">
      <nav class="breadcrumbs" aria-label="Broodkruimelpad" data-pagefind-ignore><a href="/">Home</a><span aria-hidden="true">/</span><a href={data.status === 'archived' ? '/posts/' : '/verhalen/'}>{data.status === 'archived' ? 'Archief' : 'Verhalen'}</a></nav>
      <div class="meta"><span class="badge" data-pagefind-meta="type">Verhaal</span><a href={`/onderwerpen/${data.topic}/`}>{topicLabel(data.topic)}</a><span>{data.status === 'archived' ? 'Archief · 2024' : data.status === 'refreshed' ? 'Nieuwe redactionele editie' : 'Uit het lab'}</span></div>
      <h1 data-pagefind-meta="title">{data.title}</h1>
      <p class="lede">{data.description}</p>
      <div class="byline"><span class="avatar" aria-hidden="true">JV</span><div><strong>Johan Veldhuis</strong><time datetime={data.published}>{dateLabel(data.published)}</time></div></div>
    </header>
    <div class="reading-layout">
      <article>
        {data.status === 'archived' && <ArchiveNotice refreshedUrl={data.refreshedUrl} />}
        {data.status === 'refreshed' && <aside class="notice notice-editorial"><strong>Redactioneel vernieuwd, niet opnieuw productgetest</strong><p>Deze nieuwe editie gebruikt duurzamere voorbeelden. De oorspronkelijke publicatie blijft ongewijzigd beschikbaar <a href={data.originalUrl}>in het archief</a>.</p></aside>}
        <ArticleBody body={data.body} title={data.title} />
      </article>
      <aside class="reading-aside" data-pagefind-ignore>
        <div class="aside-box"><strong>Van lezen naar proberen</strong><p>Gebruik de voorbeelden als startpunt. Controleer altijd de uitkomst en deel alleen gegevens die je mag gebruiken.</p><a href={`/onderwerpen/${data.topic}/`}>Meer over {topicLabel(data.topic)} →</a></div>
        <div class="aside-box"><strong>Verder ontdekken</strong><ul>{related.map((item) => <li><a href={item.data.url}>{item.data.title}</a></li>)}</ul><a href="/videos/">Naar de videocollectie ↗</a></div>
      </aside>
    </div>
  </div>
</Base>
