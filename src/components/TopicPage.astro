---
import Base from '../layouts/Base.astro';
import ArticleCard from './ArticleCard.astro';
import { getArticles, topicLabel } from '../lib/content';
interface Props { topic: string }
const { topic } = Astro.props;
const articles = (await getArticles()).filter((article) => article.data.topic === topic);
---
<Base title={topicLabel(topic)} canonical={`/onderwerpen/${topic}/`}>
  <div class="wrap">
    <header class="page-head"><div class="eyebrow">Onderwerp</div><h1>{topicLabel(topic)}</h1><p class="lede">Praktische artikelen om je prompts stap voor stap duidelijker en bruikbaarder te maken.</p></header>
    <div class="section-title"><h2>Artikelen</h2><a href="/artikelen/">Alle artikelen ↗</a></div>
    <div class="cards">{articles.map((article) => <ArticleCard article={article} />)}</div>
    <div style="height:45px"></div>
  </div>
</Base>
